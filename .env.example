# Apify API Token for curious_coder~linkedin-jobs-scraper
APIFY_API_TOKEN=your_apify_api_token_here

# Supabase REST API. On the server, SUPABASE_KEY must be the SECRET key (sb_secret_...):
# supabase_schema.sql locks the jobs table to it. Never put the secret key in the dashboard HTML.
SUPABASE_URL=https://advkivbiwhwpncyomcei.supabase.co/rest/v1/
SUPABASE_KEY=your_supabase_secret_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_9hgSwmou0V8xdADTAG-mjw_3fFL3Z_t

# Lusha API Key (for decision maker contact enrichment)
LUSHA_API_KEY=your_lusha_api_key_here

# Optional: Google Gemini key for LLM-based ATS tailoring
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Resume parser: set to false to skip Docling and use basic pypdf/python-docx extraction
USE_DOCLING=true

# Web server port
PORT=8080

# Leave empty so anyone who signs up can use the dashboard, or list emails (comma-separated) to limit it
ALLOWED_EMAILS=

# Daily scout run inside `main.py serve`, for every user with a resume (set SCOUT_SCHEDULE=false to turn it off)
SCOUT_SCHEDULE=true
SCOUT_DAILY_TIME=06:30
SCOUT_TIMEZONE=Asia/Kolkata
# Default search for new users (each user can change theirs on the dashboard) and for `main.py scout`
SCOUT_QUERY=AI Product Manager
SCOUT_LOCATION=Pune, Maharashtra, India
SCOUT_MAX_JOBS=5
# "Run scout now" clicks per user per day (each run spends your Apify and Gemini credits)
SCOUT_MANUAL_RUNS_PER_DAY=3
